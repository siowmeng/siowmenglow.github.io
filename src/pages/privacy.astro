---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Privacy Policy — Nutrition Log">
  <main class="wrap">
    <h1>Privacy Policy</h1>

    <p>
      Nutrition Log is a private household food-logging tool used by
      authorized family members.
    </p>

    <p>
      It accesses Google Drive only to read meal images submitted through
      the connected Google Form, accesses Google Sheets to store nutrition
      estimates and summaries, and uses Google Cloud Gemini services to
      process meal descriptions and images.
    </p>

    <p>
      Data is used only to provide the logging service and is not sold or
      shared with third parties except Google services required to operate
      the application.
    </p>

    <p>
      Contact: siowmeng.low@gmail.com
    </p>
  </main>
</BaseLayout>
